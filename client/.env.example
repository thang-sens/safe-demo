# Web3Auth Client ID
# Get this from https://dashboard.web3auth.io/
# Create a project and copy the Client ID
VITE_WEB3AUTH_CLIENT_ID=YOUR_WEB3AUTH_CLIENT_ID_HERE

# Infura RPC URL for Sepolia testnet
# Get your project ID from https://infura.io/
VITE_INFURA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Chain ID for Sepolia testnet
VITE_CHAIN_ID=11155111

# Safe Transaction Service URL for Sepolia
VITE_SAFE_TX_SERVICE_URL=https://safe-transaction-sepolia.safe.global

# Backend API URL
# Update this if your server runs on a different port
VITE_API_URL=http://localhost:3000/api

# Safe API Key
VITE_SAFE_API_KEY=YOUR_SAFE_API_KEY_HERE