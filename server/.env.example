# MongoDB Atlas connection string
# Get this from https://cloud.mongodb.com/
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/safe-demo?retryWrites=true&w=majority

# Infura RPC URL for Sepolia testnet
# Get your project ID from https://infura.io/
INFURA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Chain ID for Sepolia testnet
CHAIN_ID=11155111

# Safe Transaction Service URL for Sepolia
SAFE_TX_SERVICE_URL=https://safe-transaction-sepolia.safe.global

# Private key for deploying Safe contracts
# IMPORTANT: Use a test account with minimal funds, never mainnet funds
# Generate a new wallet for testing: https://vanity-eth.tk/
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE